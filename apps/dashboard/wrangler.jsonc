{
  "name": "tuvimienphi-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/"],
  },
}
