{
  "name": "@org/frontend",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "scope:frontend",
      "type:app"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "vite"
            ]
          },
          {
            "env": "VITE_API_BASE_URL"
          },
          {
            "env": "VITE_APP_ENVIRONMENT"
          },
          {
            "env": "VITE_CF_ANALYTICS_TOKEN"
          },
          {
            "env": "VITE_GOOGLE_CLIENT_ID"
          },
          {
            "env": "VITE_MEDIA_BASE_URL"
          },
          {
            "env": "VITE_SENTRY_DSN"
          },
          {
            "env": "VITE_SITE_URL"
          }
        ]
      },
      "docker-build": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:noop"
      }
    }
  },
  "dependencies": {
    "@org/frontend-shared": "workspace:*",
    "@org/shared-contracts": "workspace:*",
    "@org/shared-tu-vi": "workspace:*",
    "@sentry/react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "radix-ui": "^1.6.7",
    "react-toastify": "^11.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "rollup-plugin-visualizer": "^7.1.1"
  }
}
