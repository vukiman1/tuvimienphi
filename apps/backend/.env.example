# App
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:4200

# Database
# Managed providers (Neon, Supabase, Railway, Render, Fly, Heroku) hand out one connection string.
# Setting it is enough — connection-urls.ts expands it into DB_HOST/PORT/USERNAME/PASSWORD/NAME and
# derives DB_TLS from ?sslmode=. Any variable you set explicitly still wins over the URL.
#   DATABASE_URL=postgresql://user:pass@host:5432/tuvimienphi?sslmode=require
#
# Discrete settings for the local Docker container:
# TLS is off by default here and on in production. Managed providers (Neon, Supabase, RDS) require
# it; a local container serves no TLS at all, so forcing it there fails the connection.
# Override only when needed — uncommenting these makes them win over the production defaults:
#   DB_TLS=true
#   REDIS_TLS=true
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=tuvimienphi

# Redis
# Same deal as DATABASE_URL — a rediss:// URL also turns REDIS_TLS on and its path sets REDIS_DB.
#   REDIS_URL=rediss://default:pass@host:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Which numbered Redis database to use; leave at 0 unless you share one instance across apps.
REDIS_DB=0

# CORS
CORS_ORIGINS=http://localhost:4200

# JWT
# At least 32 characters — the schema rejects anything shorter.
JWT_SECRET=dev-only-jwt-secret-not-for-production!!

# Crypto
SECRET_KEY=yoursecretkeymustbe32characters!!

# Sentry (leave SENTRY_DSN empty to disable error tracking)
SENTRY_DSN=

# Email (leave RESEND_API_KEY empty to skip sending in local dev)
RESEND_API_KEY=
EMAIL_FROM=Tu Vi Mien Phi <onboarding@resend.dev>

# CAPTCHA (Cloudflare Turnstile; enable it in config/default.yml once you have a key)
CAPTCHA_SECRET_KEY=

# Google One Tap (public client id; leave empty to disable Google login)
GOOGLE_CLIENT_ID=

# Queue dashboard at /queues (BullMQ). Without a password it is open in development and returns
# 503 in production, so set one wherever you want to reach it.
QUEUE_BOARD_USER=admin
QUEUE_BOARD_PASSWORD=
