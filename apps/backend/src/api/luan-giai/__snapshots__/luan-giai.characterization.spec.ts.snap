          "role": "user",
          "text": "{
  "cung": "Phúc Đức",
  "chi": "Mão",
  "gioiTinh": "nam",
  "chiNamSinh": "Thân",
  "chinhTinh": [
    {
      "ten": "Thiên Cơ",
      "bac": "M"
    },
    {
      "ten": "Cự Môn",
      "bac": "M"
    }
  ],
  "laVoChinhDieu": true,
  "hungTinh": [],
  "catTinh": [
    {
      "ten": "Thiên Thọ",
      "the": "tam hợp"
